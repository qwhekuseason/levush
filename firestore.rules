rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The storefront never talks to Firestore directly — every read and write
    // goes through the API (/api/*), which uses the Admin SDK and is not
    // subject to these rules. The server is where prices, stock, coupons and
    // admin access are enforced, so browsers get no direct access at all.
    //
    // Without this, anyone could write an order with any price straight into
    // the database, or download every coupon (including hidden codes).

    // Catalogue is public data anyway; read-only access is harmless.
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // orders, coupons (+ redemptions), settings, and anything else: API only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
