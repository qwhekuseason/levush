rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Products: Anyone can read visible products; Admin has full read/write access
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'admin@levush.com';
    }

    // Orders: Users can read their own orders; Admin has full access; Anyone can create an order (checkout)
    match /orders/{orderId} {
      allow create: if true;
      allow read: if request.auth != null && (request.auth.token.email == 'admin@levush.com' || resource.data.uid == request.auth.uid);
      allow update, delete: if request.auth != null && request.auth.token.email == 'admin@levush.com';
    }

    // Coupons: Anyone can read/validate coupons; Admin has full control
    match /coupons/{couponCode} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'admin@levush.com';
    }
  }
}
