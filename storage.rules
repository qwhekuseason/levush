rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product image uploads: public read, authenticated admin write
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default rule
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
