# Express server config
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Comma-separated emails that get the admin role (manage products/orders/prayers).
# e.g. ADMIN_EMAILS=you@example.com,partner@example.com
ADMIN_EMAILS=

# In dev mode (no Firebase), if ADMIN_EMAILS is empty you can sign in as the
# built-in dev admin "admin@levush.test" to try the admin panel.

# Firebase Admin (OPTIONAL — leave unset to run in in-memory dev mode).
# Option A: paste the whole service-account JSON on one line:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}
# Option B: point to the service-account JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
